# ─────────────────────────────────────────────────────────────
#  GridLock Backend — Environment Variables
#  Copy this file to `.env` and fill in your real values.
#  Never commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── AI / LLM ──────────────────────────────────────────────────
# Groq API key — used for:
#   • Tactical "What-If" Scenario Simulator
#   • Voice Feedback Brief Parser
#   • Command Center news summarisation
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key — used for:
#   • Command Center affected-zones detection (with search grounding)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API key — used for:
#   • Text-to-Speech voice briefings
# Get your key at: https://app.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Traffic & News Data ────────────────────────────────────────
# SerpAPI key — used for:
#   • Command Center live Google News scraping (Bangalore traffic events)
# Get your key at: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# TomTom API key — used for:
#   • Live traffic flow speed data in Command Center
# Get your key at: https://developer.tomtom.com/user/register
TOMTOM_KEY=your_tomtom_api_key_here

# Weather Union API key — used for:
#   • Live rainfall and visibility data in Command Center
# Get your key at: https://www.weatherunion.com
WEATHER_UNION_KEY=your_weather_union_key_here

# ── Twilio WhatsApp Dispatch ───────────────────────────────────
# Used for: Sending operational briefings to field officers via WhatsApp
# Get your credentials at: https://console.twilio.com
# Note: Use the WhatsApp Sandbox for testing (free)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The WhatsApp-enabled sender number (Sandbox: +14155238886)
# Format: +1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=+14155238886
